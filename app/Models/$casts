<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class TimetableLog extends Model
{
    use HasFactory;

    protected $fillable = [
        'course_id',
        'action',
        'old_values',
        'new_values',
        'user_id',
    ];

    // AJOUTE CE BLOC ICI :
    protected $casts = [
        'old_values' => 'array',
        'new_values' => 'array',
    ];
}